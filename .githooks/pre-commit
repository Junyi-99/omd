#!/bin/sh
# Refuse commits that would publish private data. This repo is public and is
# pulled by every machine, so a leak means rewriting history everywhere.
#
# Checked: staged files that must stay local, and added lines that match a
# secret pattern below or one in .githooks/deny.local (git-ignored; one
# extended regex per line, # comments allowed) for private names such as
# internal hostnames, which must not appear in this tracked file either.
#
# A line containing "omd-allow-secret" is skipped. To bypass the hook once,
# run git commit --no-verify. omd enables it with core.hooksPath=.githooks.
set -eu
root=$(git rev-parse --show-toplevel)
deny_local="$root/.githooks/deny.local"

# Paths that hold per-machine or secret data; .gitignore already lists them,
# this catches git add -f.
blocked_paths='(^|/)hosts\.yaml$|\.local$|^etc/configstore/|(^|/)id_(rsa|ed25519|ecdsa)[^/]*$|\.(pem|p12|key)$|(^|/)\.env$'

# Secret formats. Character classes keep each pattern from matching itself.
patterns='[$]ANSIBLE_VAULT;
-----BEGIN [A-Z ]*PRIVATE KEY-----
ansible_(ssh_|become_)?pass(word)?[[:space:]]*[:=][[:space:]]*[^[:space:]{]
gh[pousr]_[A-Za-z0-9]{36}
github_pat_[A-Za-z0-9_]{40,}
sk-ant-[A-Za-z0-9_-]{20,}
sk-(proj-)?[A-Za-z0-9]{32,}
AKIA[0-9A-Z]{16}
AIza[0-9A-Za-z_-]{35}
xox[abprs]-[0-9A-Za-z-]{10,}
(^|[^0-9.])(10|192[.]168|172[.](1[6-9]|2[0-9]|3[01]))[.][0-9]{1,3}[.][0-9]{1,3}([^0-9.]|$)'

if [ -f "$deny_local" ]; then
    local_patterns=$(grep -Ev '^[[:space:]]*(#|$)' "$deny_local" || true)
    [ -z "$local_patterns" ] || patterns="$patterns
$local_patterns"
fi

status=0

bad_paths=$(git diff --cached --name-only --diff-filter=ACMR | grep -E "$blocked_paths" || true)
if [ -n "$bad_paths" ]; then
    echo "pre-commit: these files must stay local (unstage with git restore --staged):" >&2
    printf '%s\n' "$bad_paths" | sed 's/^/  /' >&2
    status=1
fi

# Added lines as "file:line:text", taken from the zero-context staged diff.
added=$(git diff --cached -U0 --no-color --no-ext-diff --diff-filter=ACMR |
    awk '
        /^\+\+\+ / { file = substr($0, 7); next }
        /^@@ / { split($3, a, ","); line = substr(a[1], 2) + 0; next }
        /^\+/ { if (file != ".githooks/pre-commit") print file ":" line ":" substr($0, 2); line++ }
    ' | grep -v 'omd-allow-secret' || true)

if [ -n "$added" ]; then
    # One grep over everything first; only the few suspect lines are re-checked
    # pattern by pattern to report which one fired.
    # Match the text alone so ^ anchors work, then map back by entry number.
    nums=$(printf '%s\n' "$added" | cut -d: -f3- |
        grep -nE -e "$(printf '%s\n' "$patterns" | paste -sd'|' -)" | cut -d: -f1 || true)
    suspects=$(printf '%s\n' "$added" | awk -v nums="$(printf '%s ' $nums)" '
        BEGIN { n = split(nums, a, " "); for (i = 1; i <= n; i++) want[a[i]] = 1 }
        NR in want')
    hits=$(printf '%s\n' "$suspects" | while IFS= read -r entry; do
        [ -n "$entry" ] || continue
        text=${entry#*:}
        text=${text#*:}
        printf '%s\n' "$patterns" | while IFS= read -r pattern; do
            [ -n "$pattern" ] || continue
            if printf '%s\n' "$text" | grep -Eq -- "$pattern"; then
                printf '  %s\n    matches: %s\n' "$(printf '%s' "$entry" | cut -c1-160)" "$pattern"
                break
            fi
        done
    done)
    if [ -n "$hits" ]; then
        echo "pre-commit: staged lines look private:" >&2
        printf '%s\n' "$hits" >&2
        status=1
    fi
fi

if [ "$status" -ne 0 ]; then
    echo "pre-commit: commit refused. Mark a false positive with omd-allow-secret on that line," >&2
    echo "or bypass once with git commit --no-verify." >&2
fi
exit "$status"
