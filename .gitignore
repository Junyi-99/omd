# XDG_CONFIG_HOME points at etc/, so every tool writes its state (and often
# credentials) here. Ignore everything and opt tracked configs back in.
etc/*
!etc/ansible/
!etc/code-server/
!etc/completions/
!etc/cursor/
!etc/fortunes/
!etc/git/
!etc/helm/
!etc/kitty/
!etc/lazygit/
!etc/lints/
!etc/nvim/
!etc/openfortivpn/
!etc/ssh/
!etc/tmux/
!etc/zsh/
etc/lazygit/state.yml
etc/kitty/*.bak
etc/kitty/*.pre*
etc/kitty/kitty.conf.default-reference

Desktop.ini



*chat-sessions*
*/htoprc
*/btop.conf
*.pyc

.zcompdump*
.Trashes
.Spotlight-V100
.DS_Store

.history
